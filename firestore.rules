rules_version = '2';

// Security rules for the vocab-games leaderboards & duel rooms.
// Paste this into Firebase console -> Firestore Database -> Rules,
// or deploy with `firebase deploy --only firestore:rules` if you use the CLI.
//
// Every visitor is signed in anonymously (see firebase-client.js), so
// request.auth is always present once the client has finished loading.
// There is no server validating gameplay, so this cannot stop a
// determined attacker from posting a fabricated score directly through
// the SDK — it can only enforce shape/ownership/bounds. That's an
// inherent limitation of any purely static (no game-server) leaderboard.

service cloud.firestore {
  match /databases/{database}/documents {

    // /leaderboards/{gameId}/{period}/{scoreId}
    // period is 'alltime' or a UTC date key like '2026-08-25' for daily boards.
    match /leaderboards/{gameId}/{period}/{scoreId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;

      // Score records are immutable once posted — no editing/deleting a
      // rank after the fact.
      allow update, delete: if false;
    }

    // /duels/{gameId_ROOMCODE}
    match /duels/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;

      // Only players already present in the room may update it
      // (join-writes add themselves via a merge from the client first).
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.players
            || request.auth.uid in request.resource.data.players);

      allow delete: if false;
    }
  }
}
